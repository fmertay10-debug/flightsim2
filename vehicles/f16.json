// F-16 -- REAL tabular model: Stevens & Lewis / NASA TP-1538 aerodynamics
// (vehicles/f16/*.csv) + the S&L turbofan (idle/mil/max tables with power-lever
// dynamics). Ported from the sibling PROJECT model; aero validated to the
// reference buildup in tests/test_f16aero.cpp.
//
// This airframe is statically UNSTABLE at xcg = 0.35 cbar (relaxed stability,
// like the real jet) and its aileron sign is INVERTED vs the missile
// convention (+aileron -> LEFT roll). Since the allocation conversion
// (ADR-0004) the inverted sign lives where it belongs: in F16Aero's
// effectiveness columns (differenced from the dlda tables) -- the law's roll
// gains are ordinary positive numbers. The inner pitch loop still acts as the
// stability augmentation holding this airframe flyable.
//
// Components: [f16_aero] table set, [f16_engine] turbofan. Mass: constant
// tensor with Ixz. GNC: cascaded allocation law + fast servo.
{
  "mass": {
    "model": "constant",
    "mass_kg": 9295.48,
    "inertia": { "ixx": 12874.85, "iyy": 75673.62, "izz": 85552.11, "ixz": 1331.41 }
  },

  "components": [
    { "type": "f16_aero", "dir": "f16" },
    { "type": "f16_engine", "dir": "f16" }
  ],

  "gnc": {
    "control_law": {
      "type": "aircraft_allocated",
      "gains": {
        "pitch_kp": 24, "pitch_kd": 9, "pitch_ki": 10,
        "roll_kp": 15,  "roll_kd": 9,
        "yaw_damp": 0,
        "heading_kp": 0.6,
        "alt_to_vs": 0.2, "vs_kp": 0.03, "vs_ki": 0.02,
        "speed_kp": 0.06, "speed_ki": 0.02
      },
      "limits": {
        "max_bank_deg": 55, "max_pitch_deg": 20, "max_climb_rate_ms": 120,
        "max_ang_accel_dps2": 3000, "int_limit": 1.0
      }
    },
    "actuator": { "tau_s": 0.05, "rate_dps": 60, "limit_deg": 25 }
  }
}
