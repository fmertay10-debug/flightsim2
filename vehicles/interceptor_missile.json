// Compact, agile surface-to-air interceptor (derivative aero model). Short
// body + low inertia + strong fins give the control authority a sounding
// rocket lacks -- this is what actually catches a maneuvering target.
// Moderate static margin (cma) so it points fast without being unstable.
{
  "mass": {
    "model": "dry_plus_propellant",
    "dry_mass_kg": 65,
    "inertia": { "ixx": 0.6, "iyy": 40, "izz": 40 }
  },

  "components": [
    {
      "type": "rocket_aero",
      "sref_m2": 0.0314, "lref_m": 2.6, "dref_m": 0.20,
      "ca0": 0.30,
      "cna": 14.0,  "cnde": 6.0,
      "cma": -6.0,  "cmq": -180.0, "cmde": -22.0,
      "clp": -12.0, "clda": 5.0
    },
    {
      "type": "solid_motor",
      "propellant_kg": 20,
      "thrust_curve": [ [0.0, 16000], [0.3, 18000], [3.0, 16000], [3.4, 0] ]
    }
  ],

  "gnc": {
    "control_law": {
      "type": "allocated_attitude",
      "gains": {
        "pitch_kp": 12000, "pitch_kd": 500, "pitch_ki": 1500,
        "yaw_kp": 12000, "yaw_kd": 500,  "yaw_ki": 1500,
        "roll_kp": 60,   "roll_kd": 20
      },
      "limits": { "max_ang_accel_dps2": 40000, "int_limit": 1.5, "vertical_guard_deg": 80 }
    },
    "actuator": { "tau_s": 0.02, "rate_dps": 400, "limit_deg": 25 }
  }
}
