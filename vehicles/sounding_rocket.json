// Fin-stabilized sounding rocket, 85 kg at liftoff (60 dry + 25 propellant).
// Missile-convention derivatives per radian; axisymmetric yaw terms default
// to mirrors of the pitch terms (see RocketAero).
{
  "mass": {
    "model": "dry_plus_propellant",
    "dry_mass_kg": 60,
    "inertia": { "ixx": 2, "iyy": 320, "izz": 320 }
  },

  "components": [
    {
      "type": "rocket_aero",
      "sref_m2": 0.049, "lref_m": 3.0, "dref_m": 0.25,
      "ca0": 0.35,
      "cna": 10.0,  "cnde": 1.5,
      "cma": -12.0, "cmq": -120.0, "cmde": -8.0,
      "clp": -6.0,  "clda": 3.0
    },
    {
      "type": "solid_motor",
      "propellant_kg": 25,
      "thrust_curve": [ [0.0, 6000], [0.2, 7000], [5.0, 6500], [5.5, 0] ]
    }
  ],

  "gnc": {
    "control_law": {
      "type": "allocated_attitude",
      "gains": {
        "pitch_kp": 150, "pitch_kd": 60, "pitch_ki": 30,
        "yaw_kp": 150,   "yaw_kd": 60,   "yaw_ki": 30,
        "roll_kp": 40,   "roll_kd": 15
      },
      "limits": { "max_ang_accel_dps2": 6000, "int_limit": 1.0, "vertical_guard_deg": 84 }
    },
    "actuator": { "tau_s": 0.03, "rate_dps": 200, "limit_deg": 15 }
  }
}
