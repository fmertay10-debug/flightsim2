// Hybrid launcher -- TVC *and* fins on one airframe, flown by the
// allocation-based attitude law. This vehicle cannot be expressed with the
// direct-write PIDs (one law writes one channel family); here ONE law tracks
// the pitch program the whole flight and the Allocator blends authority by
// the components' live effectiveness:
//   on the pad     qbar ~ 0        -> the gimbal does all the work
//   as speed builds fin columns grow -> authority shifts to the fins
//   after burnout  thrust = 0       -> gimbal column dies, fins only
// No mode switching, no gain scheduling on "phase" -- the blend falls out of
// the effectiveness matrix changing with flight condition (ADR-0002).
{
  "mass": {
    "model": "constant", "mass_kg": 520,
    "inertia": { "ixx": 16, "iyy": 1500, "izz": 1500 },
    "xcg_m": 3.5
  },

  "components": [
    {
      "type": "rocket_aero",
      "sref_m2": 0.196, "lref_m": 6.0, "dref_m": 0.5,
      "ca0": 0.30, "cna": 12.0,
      "cma": -0.4, "cmq": -40.0, "clp": -12.0,
      "cnde": 0.6, "cmde": -3.0, "clda": 2.0
    },
    {
      "type": "solid_motor", "propellant_kg": 210,
      "thrust_curve": [[0.0, 85000], [0.3, 92000], [7.5, 80000], [8.0, 0]],
      "gimbal": { "nozzle_station_m": 6.0, "max_gimbal_deg": 6 }
    }
  ],

  "gnc": {
    "control_law": {
      "type": "allocated_attitude",
      "gains": {
        "pitch_kp": 150, "pitch_kd": 60, "pitch_ki": 30,
        "yaw_kp": 150,   "yaw_kd": 60,   "yaw_ki": 30,
        "roll_kp": 40,   "roll_kd": 15
      },
      "limits": { "max_ang_accel_dps2": 6000, "int_limit": 1.0, "vertical_guard_deg": 84 }
    },
    "actuator": { "tau_s": 0.03, "rate_dps": 200, "limit_deg": 20, "gimbal_limit_deg": 6 }
  }
}
