// SSM engagement: a surface-to-surface missile (DATCOM aero + LQR autopilot)
// launched at a loft angle off a ground rail, boosts, and runs a
// proportional-navigation terminal onto a fixed target ~14 km downrange.
{
  "name": "ssm_strike",
  "simulation": { "dt_s": 0.001, "duration_s": 70, "ground_level_m": 0 },
  "environment": { "gravity": "spherical", "wind": { "type": "constant", "ned_ms": [6, 3, 0] } },

  "vehicles": [
    {
      "name": "ssm",
      "vehicle": "../vehicles/generated/ssm/vehicle.json",
      "dynamics": "six_dof",
      "initial": {
        "position_ned_m": [0, 0, -3],
        "velocity_ned_ms": [22, 0, -34],
        "euler_deg": [0, 57, 0]
      },
      "guidance": {
        "type": "pro_nav", "target": "target",
        "nav_gain": 3.5, "max_pitch_deg": 80, "max_yaw_deg": 60, "blind_range_m": 30
      },
      "log": "output/ssm_strike/ssm.csv", "log_decimation": 10
    },
    {
      "name": "target",
      "dynamics": "kinematic",
      "initial": {
        "position_ned_m": [14000, 900, -10],
        "velocity_ned_ms": [0, 0, 0],
        "euler_deg": [0, 0, 0]
      },
      "log": "output/ssm_strike/target.csv", "log_decimation": 20
    }
  ],

  "end_conditions": {
    "intercept": { "pursuer": "ssm", "target": "target", "hit_radius_m": 12 }
  }
}
