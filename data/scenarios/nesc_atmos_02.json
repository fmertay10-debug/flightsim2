// NESC atmospheric check-case 2: dragless tumbling brick (NASA/TM-2015-218675
// Vol. II C.1.2, Table 26). 30,000 ft over the equator, released at rest with
// inertial body rates (10, 20, 30) deg/s; no aero at all. Gravitation: J2
// (Table 73 constants). Our frame is non-rotating, so the comparable channels
// are the INERTIAL body rates (exactly their bodyAngularRateWrtEi) and the
// vertical channel; their NED frame also rotates with the Earth, so Euler
// angles carry an O(0.1 deg) frame drift over 30 s.
{
  "name": "nesc_atmos_02",
  "simulation": { "dt_s": 0.0002, "duration_s": 30, "ground_level_m": 0 },
  "environment": {
    "gravity": { "type": "inverse_square", "mu_m3_s2": 3.986004418e14,
                 "radius_m": 6378137.0, "j2": 0.00108262982 },
    "wind": { "type": "none" }
  },
  "vehicles": [
    {
      "name": "brick",
      "vehicle": "../vehicles/nesc/brick/vehicle_free.json",
      "dynamics": "six_dof",
      "initial": { "position_ned_m": [0, 0, -9144],
                   "velocity_ned_ms": [0, 0, 0],
                   "euler_deg": [0, 0, 0],
                   "rates_dps": [10, 20, 30] },
      "log": "data/output/nesc_atmos_02/brick.csv",
      "log_decimation": 50
    }
  ]
}
