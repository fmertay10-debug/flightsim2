// AAM engagement: an air-to-air missile (DATCOM aero + LQR autopilot) is
// launched forward from a fighter at 6 km and runs a proportional-navigation
// intercept on a maneuvering bandit. All three vehicles are logged.
{
  "name": "aam_intercept",
  "simulation": { "dt_s": 0.002, "duration_s": 20, "ground_level_m": 0 },
  "environment": { "gravity": "flat", "wind": { "type": "none" } },

  "vehicles": [
    {
      "name": "shooter",
      "dynamics": "kinematic",
      "initial": { "position_ned_m": [0, 0, -6000], "velocity_ned_ms": [260, 0, 0] },
      "log": "data/output/aam_intercept/shooter.csv", "log_decimation": 10
    },
    {
      "name": "aam",
      "vehicle": "../vehicles/generated/aam/vehicle.json",
      "dynamics": "six_dof",
      "initial": {
        "position_ned_m": [30, 0, -6000],
        "velocity_ned_ms": [260, 0, 0],
        "euler_deg": [0, 0, 0]
      },
      "guidance": {
        "type": "pro_nav", "target": "bandit",
        "nav_gain": 5.0, "max_pitch_deg": 50, "max_yaw_deg": 85, "blind_range_m": 12
      },
      "log": "data/output/aam_intercept/aam.csv", "log_decimation": 5
    },
    {
      "name": "bandit",
      "dynamics": "kinematic",
      "turn_rate_dps": 2,
      "initial": {
        "position_ned_m": [6500, 1200, -6250],
        "velocity_ned_ms": [-240, 0, 0],
        "euler_deg": [0, 0, 180]
      },
      "log": "data/output/aam_intercept/bandit.csv", "log_decimation": 10
    }
  ],

  "end_conditions": {
    "intercept": { "pursuer": "aam", "target": "bandit", "hit_radius_m": 8 }
  }
}
