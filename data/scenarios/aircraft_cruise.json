// One aircraft: climb from 800 m to 1000 m, hold 60 m/s, then turn east.
{
  "name": "aircraft_cruise",
  "simulation": { "dt_s": 0.005, "duration_s": 120, "ground_level_m": 0 },
  "environment": { "gravity": "flat", "wind": { "type": "none" } },

  "vehicles": [
    {
      "name": "trainer-1",
      "vehicle": "../vehicles/trainer.json",
      "dynamics": "six_dof",
      "initial": {
        "position_ned_m": [0, 0, -800],
        "velocity_ned_ms": [60, 0, 0],
        "euler_deg": [0, 2, 0]
      },
      "flight_plan": [
        { "time_s": 0,  "altitude_m": 1000, "heading_deg": 0, "speed_ms": 60 },
        { "time_s": 60, "heading_deg": 90 }
      ],
      "log": "data/output/aircraft_cruise/trainer-1.csv",
      "log_decimation": 20
    }
  ]
}
