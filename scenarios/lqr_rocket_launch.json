// DATCOM rocket flown by the LQR gain-scheduled autopilot (gains designed
// offline by tools/design_autopilot.py from the vehicle's own aero + mass).
// Same airframe and pitch program as datcom_rocket_launch.json -- only the
// control block differs, so the two runs compare hand-tuned PID vs auto LQR.
{
  "name": "lqr_rocket_launch",
  "simulation": { "dt_s": 0.002, "duration_s": 120, "ground_level_m": 0 },
  "environment": { "gravity": "spherical", "wind": { "type": "constant", "ned_ms": [4, 2, 0] } },

  "vehicles": [
    {
      "name": "lqr-rocket",
      "vehicle": "../vehicles/generated/datcom_rocket/vehicle_lqr.json",
      "dynamics": "six_dof",
      "initial": {
        "position_ned_m": [0, 0, -2],
        "velocity_ned_ms": [2.6, 0, -29.9],
        "euler_deg": [0, 85, 0]
      },
      "flight_plan": [
        { "time_s": 0,  "pitch_deg": 85, "heading_deg": 0, "roll_deg": 0 },
        { "time_s": 4,  "pitch_deg": 78 },
        { "time_s": 8,  "pitch_deg": 70 },
        { "time_s": 14, "pitch_deg": 60 }
      ],
      "log": "output/lqr_rocket_launch/lqr-rocket.csv",
      "log_decimation": 25
    }
  ]
}
