// TVC rocket launch: lifts off near-vertical and follows a pitch program (a
// gravity-turn-like tip-over) steered ENTIRELY by thrust vectoring -- the
// airframe has no control fins. After motor burnout (~8 s) the gimbal loses
// authority and the vehicle coasts ballistically, as a real TVC rocket does.
{
  "name": "tvc_launch",
  "simulation": { "dt_s": 0.002, "duration_s": 60, "ground_level_m": 0 },
  "environment": { "gravity": "spherical", "wind": { "type": "constant", "ned_ms": [6, 3, 0] } },

  "vehicles": [
    {
      "name": "tvc-rocket",
      "vehicle": "../vehicles/tvc_rocket.json",
      "dynamics": "six_dof",
      "initial": {
        "position_ned_m": [0, 0, -5],
        "velocity_ned_ms": [1.5, 0, -22],
        "euler_deg": [0, 88, 0]
      },
      "flight_plan": [
        { "time_s": 0,   "pitch_deg": 88, "heading_deg": 0 },
        { "time_s": 2.5, "pitch_deg": 78 },
        { "time_s": 4,   "heading_deg": 12 },
        { "time_s": 5,   "pitch_deg": 64 },
        { "time_s": 7,   "pitch_deg": 55 }
      ],
      "log": "output/tvc_launch/tvc-rocket.csv",
      "log_decimation": 15
    }
  ]
}
