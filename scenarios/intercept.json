// Proportional-navigation intercept: the DATCOM fin-controlled rocket chases
// a turning kinematic target. Guidance overlays the flight plan; the run
// ends when the pursuer passes inside the hit radius.
{
  "name": "intercept",
  "simulation": { "dt_s": 0.002, "duration_s": 40, "ground_level_m": 0 },
  "environment": { "gravity": "flat", "wind": { "type": "none" } },

  "vehicles": [
    {
      "name": "interceptor",
      "vehicle": "../vehicles/interceptor_missile.json",
      "dynamics": "six_dof",
      "initial": {
        "position_ned_m": [0, 0, -100],
        "velocity_ned_ms": [90, 0, -55],
        "euler_deg": [0, 31, 0]
      },
      "guidance": {
        "type": "pro_nav", "target": "drone",
        "nav_gain": 4.0, "max_pitch_deg": 60, "max_yaw_deg": 80,
        "blind_range_m": 25
      },
      "log": "output/intercept/interceptor.csv",
      "log_decimation": 10
    },
    {
      "name": "drone",
      "dynamics": "kinematic",
      "turn_rate_dps": 4,
      "initial": {
        "position_ned_m": [5000, 1500, -1800],
        "velocity_ned_ms": [-160, 0, 0],
        "euler_deg": [0, 0, 180]
      },
      "log": "output/intercept/drone.csv",
      "log_decimation": 10
    }
  ],

  "end_conditions": {
    "intercept": { "pursuer": "interceptor", "target": "drone", "hit_radius_m": 8 }
  }
}
